# Root reference only — copy values into apps/api/.env and apps/web/.env
# See docs/01-build-playbook.md for setup details.

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Supabase (backend: all keys; frontend: URL + anon key only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL (from Supabase → Settings → Database)
DATABASE_URL=
DIRECT_URL=

# Stripe (backend only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (backend only)
RESEND_API_KEY=
EMAIL_FROM="Job Board <no-reply@example.com>"
