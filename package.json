{
  "name": "jobs-platform",
  "version": "0.0.1",
  "private": true,
  "description": "MVP job listing platform for Australia (npm workspaces monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "lint:web": "npm run lint -w apps/web",
    "lint:api": "npm run lint -w apps/api"
  },
  "engines": {
    "node": ">=20"
  }
}
