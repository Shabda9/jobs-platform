NODE_ENV=development
PORT=4000

# PostgreSQL connection strings (not the Supabase HTTPS project URL)
DATABASE_URL=
DIRECT_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
# JWT secret from Supabase Dashboard → Project Settings → API → JWT Secret
