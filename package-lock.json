{
  "name": "jobs-platform",
  "version": "0.0.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "jobs-platform",
      "version": "0.0.1",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@jobs-platform/api-client": {
      "resolved": "packages/api-client",
      "link": true
    },
    "node_modules/@jobs-platform/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/api-client": {
      "name": "@jobs-platform/api-client",
      "version": "0.0.1"
    },
    "packages/shared": {
      "name": "@jobs-platform/shared",
      "version": "0.0.1"
    }
  }
}
